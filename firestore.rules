rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             request.auth.token.email == 'madihaapvtltd@gmail.com';
    }

    function hasRole(role) {
      return isAuthenticated() &&
             request.auth.token.role == role;
    }

    function isHRManager() {
      return hasRole('hr_manager') || isSuperAdmin();
    }

    function isDepartmentManager() {
      return hasRole('department_manager') || isHRManager();
    }

    function isSupervisor() {
      return hasRole('supervisor') || isDepartmentManager() || request.auth.token.email == 'leela@madihaahrms.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEmployeeOwner(employeeId) {
      return isAuthenticated() && request.auth.token.employeeId == employeeId;
    }

    // Allow read/write for super admin (fallback)
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Users collection - for user management
    match /users/{userId} {
      allow read: if isAuthenticated(); // Temporarily allow all authenticated users to read for development
      allow create: if isSuperAdmin() || isHRManager() || isOwner(userId);
      allow update: if isSuperAdmin() || isHRManager() || isOwner(userId);
      allow delete: if isSuperAdmin();
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }
    
    // Attendance collection
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() || isHRManager() || isOwner(resource.data.userId);
    }
    
    // Leave requests collection
    match /leave_requests/{leaveId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || isHRManager() || isOwner(resource.data.employeeId);
      allow delete: if isSuperAdmin() || isHRManager() || isSupervisor();
    }

    // Leave balances collection
    match /leave_balances/{balanceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }
    
    // Payroll collection
    match /payroll/{payrollId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }

    // Overtime collection
    match /overtime_requests {
      allow list: if isAuthenticated();
    }
    match /overtime_requests/{overtimeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // Biometric overtime collection
    match /biometric_overtime {
      allow list: if isAuthenticated();
    }
    match /biometric_overtime/{bioId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }

    // Recruitment collection
    match /recruitment/{recruitmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }
    
    // Training collection
    match /training/{trainingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }
    
    // Performance collection
    match /performance/{performanceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }
    
    // Lifecycle collection
    match /lifecycle/{lifecycleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }
    
    // Reports collection
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create, delete: if isSuperAdmin() || isHRManager();
    }
    
    // Accommodation collections
    match /accommodations/{accommodationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }
    
    match /floors/{floorId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }
    
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }
    
    match /beds/{bedId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }
    
    match /accommodation_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }

    // Work locations collection
    match /workLocations/{locationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }

    // Bonuses collection
    match /bonuses/{bonusId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }

    // Friday schedules collection
    match /friday_schedules/{scheduleId} {
      allow read, write: if isAuthenticated();
    }

    // Disciplinary actions collection
    match /disciplinaryActions/{actionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }

    // Petrol requests collection
    match /petrol_requests {
      allow list: if isSupervisor();
    }
    match /petrol_requests/{requestId} {
      allow read: if isSupervisor();
      allow create: if isSupervisor();
      allow update, delete: if isSuperAdmin() || isHRManager();
    }

    // Vehicles collection
    match /vehicles {
      allow list: if isSupervisor();
    }
    match /vehicles/{vehicleId} {
      allow read: if isSupervisor();
      allow create, update, delete: if isSuperAdmin() || isHRManager();
    }
  }
}
